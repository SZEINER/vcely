# Local development defaults to SQLite and needs no .env file.
# For production, set these values in the hosting environment or in an untracked .env file.
NODE_ENV=production
PORT=3001
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sql_vcely_szeiner_com
DB_USER=sql_vcely_szeiner_com
DB_PASSWORD=replace_with_database_password
# Set true only when the MySQL server supports verified TLS.
DB_SSL=false
